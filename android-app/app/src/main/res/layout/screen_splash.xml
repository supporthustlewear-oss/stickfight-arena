<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center"
    android:background="@drawable/bg_gradient">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="🥊 STICKFIGHT" android:textColor="#ffffff"
        android:textSize="30sp" android:textStyle="bold" android:letterSpacing="0.1"/>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="A R E N A" android:textColor="@color/gold"
        android:textSize="13sp" android:textStyle="bold" android:letterSpacing="0.5"
        android:layout_marginTop="4dp"/>
    <TextView android:id="@+id/splash_badge" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:text="🎮 CONTROLLER"
        android:textColor="@color/gold" android:textSize="11sp" android:letterSpacing="0.3"
        android:layout_marginTop="18dp" android:alpha="0"/>
</LinearLayout>
