<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/bg_gradient">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:gravity="center_horizontal"
        android:padding="22dp" android:paddingTop="46dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="JOIN A GAME" android:textColor="#ffffff"
            android:textSize="19sp" android:textStyle="bold" android:letterSpacing="0.2"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Enter the room code from the big screen" android:textColor="@color/muted"
            android:textSize="12sp" android:layout_marginTop="4dp"/>
        <EditText android:id="@+id/input_code" android:layout_width="match_parent"
            android:layout_height="58dp" android:layout_marginTop="18dp"
            android:hint="AAA-111" android:textColor="@color/gold"
            android:textColorHint="@color/muted" android:textSize="26sp"
            android:textStyle="bold" android:letterSpacing="0.4" android:gravity="center"
            android:background="@drawable/btn_panel" android:inputType="text"
            android:maxLength="7" android:textAllCaps="true"/>
        <Button android:id="@+id/btn_enter" android:layout_width="match_parent"
            android:layout_height="58dp" android:layout_marginTop="12dp"
            android:text="ENTER CODE" android:textSize="15sp"
            android:background="@drawable/btn_gold" style="@style/SFA.Button"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="————— OR —————" android:textColor="@color/muted"
            android:textSize="11sp" android:layout_marginTop="14dp"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginTop="10dp">
            <Button android:id="@+id/btn_scan" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="56dp" android:layout_marginEnd="6dp"
                android:text="📷 SCAN QR" android:textSize="13sp"
                android:background="@drawable/btn_p2" style="@style/SFA.Button"/>
            <Button android:id="@+id/btn_detect" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="56dp" android:layout_marginStart="6dp"
                android:text="🔗 AUTO-DETECT" android:textSize="13sp"
                android:background="@drawable/btn_p2" style="@style/SFA.Button"/>
        </LinearLayout>
        <TextView android:id="@+id/detect_result" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="" android:textColor="@color/muted"
            android:textSize="12sp" android:layout_marginTop="8dp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="GAME SERVER ADDRESS (LAN)" android:textColor="@color/muted"
            android:textSize="10sp" android:letterSpacing="0.3" android:layout_marginTop="18dp"/>
        <EditText android:id="@+id/input_server" android:layout_width="match_parent"
            android:layout_height="52dp" android:layout_marginTop="6dp"
            android:hint="http://192.168.1.10:3000" android:textColor="#ffffff"
            android:textColorHint="@color/muted" android:textSize="14sp" android:gravity="center"
            android:background="@drawable/btn_panel" android:inputType="textUri"/>
        <Button android:id="@+id/btn_save_server" android:layout_width="wrap_content"
            android:layout_height="44dp" android:layout_marginTop="6dp"
            android:text="SAVE SERVER" android:textSize="11sp"
            android:background="@drawable/btn_panel" style="@style/SFA.Button"/>
        <Button android:id="@+id/btn_back_home" android:layout_width="wrap_content"
            android:layout_height="48dp" android:layout_marginTop="14dp"
            android:text="← BACK" android:textSize="13sp"
            android:background="@drawable/btn_panel" style="@style/SFA.Button"/>
    </LinearLayout>
</ScrollView>
