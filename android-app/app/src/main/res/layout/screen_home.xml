<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center" android:padding="28dp"
    android:background="@drawable/bg_gradient">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="🥊 STICKFIGHT" android:textColor="#ffffff"
        android:textSize="26sp" android:textStyle="bold" android:letterSpacing="0.1"/>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="ARENA · CONTROLLER" android:textColor="@color/gold"
        android:textSize="11sp" android:textStyle="bold" android:letterSpacing="0.4"
        android:layout_marginTop="6dp"/>
    <TextView android:id="@+id/home_conn" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:text="connecting…"
        android:textColor="@color/muted" android:textSize="12sp"
        android:layout_marginTop="10dp"/>
    <Button android:id="@+id/btn_join" android:layout_width="match_parent"
        android:layout_height="64dp" android:layout_marginTop="26dp"
        android:text="🎮 JOIN GAME" android:textSize="17sp"
        android:background="@drawable/btn_p1" style="@style/SFA.Button"/>
    <Button android:id="@+id/btn_how" android:layout_width="match_parent"
        android:layout_height="56dp" android:layout_marginTop="10dp"
        android:text="📖 HOW TO PLAY" android:background="@drawable/btn_panel"
        style="@style/SFA.Button"/>
    <Button android:id="@+id/btn_settings_home" android:layout_width="match_parent"
        android:layout_height="56dp" android:layout_marginTop="10dp"
        android:text="⚙️ SETTINGS" android:background="@drawable/btn_panel"
        style="@style/SFA.Button"/>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="v1.0 · native Java + Kotlin" android:textColor="@color/muted"
        android:textSize="11sp" android:layout_marginTop="22dp"/>
</LinearLayout>
