<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center" android:padding="30dp"
    android:background="@drawable/bg_gradient">
    <TextView android:id="@+id/res_title" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:text="VICTORY"
        android:textColor="@color/gold" android:textSize="38sp" android:textStyle="bold"
        android:letterSpacing="0.15"/>
    <TextView android:id="@+id/res_sub" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:text="" android:textColor="@color/muted"
        android:textSize="13sp" android:layout_marginTop="8dp" android:gravity="center"/>
    <Button android:id="@+id/btn_res_home" android:layout_width="240dp"
        android:layout_height="54dp" android:layout_marginTop="26dp"
        android:text="← BACK TO HOME" android:background="@drawable/btn_panel"
        style="@style/SFA.Button"/>
</LinearLayout>
