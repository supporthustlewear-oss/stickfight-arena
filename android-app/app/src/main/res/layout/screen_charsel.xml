<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/bg_gradient">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:gravity="center_horizontal"
        android:padding="18dp" android:paddingTop="30dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="CHOOSE YOUR FIGHTER" android:textColor="#ffffff"
            android:textSize="17sp" android:textStyle="bold" android:letterSpacing="0.25"/>
        <GridLayout android:id="@+id/chars_grid" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="14dp"
            android:columnCount="2" android:rowCount="4"/>
        <TextView android:id="@+id/cs_status" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text=""
            android:textColor="@color/muted" android:textSize="12sp"
            android:layout_marginTop="10dp"/>
        <Button android:id="@+id/btn_lock" android:layout_width="260dp"
            android:layout_height="56dp" android:layout_marginTop="12dp"
            android:text="🔒 LOCK IN" android:textSize="15sp"
            android:background="@drawable/btn_gold" style="@style/SFA.Button"/>
    </LinearLayout>
</ScrollView>
